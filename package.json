{
  "name": "wall-go",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:unit": "vitest run src --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest watch",
    "training:import-qtable": "ts-node --esm --transpileOnly src/training/importWinningTracesToQTable.ts",
    "training:compare-learning": "node --import ./scripts/run-ts-node-esm.mjs src/training/compareLearningAgents.ts",
    "training:train-learning": "node --import ./scripts/run-ts-node-esm.mjs src/training/trainLearningAgent.ts",
    "training:train-learning-q2": "node --import ./scripts/run-ts-node-esm.mjs src/training/trainLearningAgentQ2.ts",
    "training:q3": "node --import ./scripts/run-ts-node-esm.mjs src/training/trainLearningAgentQ3.ts pilot-10",
    "training:q3:500": "node --import ./scripts/run-ts-node-esm.mjs src/training/trainLearningAgentQ3.ts train-500",
    "training:evaluate-q3-500": "node --import ./scripts/run-ts-node-esm.mjs src/training/evaluateLearningAgentQ3.ts",
    "evaluate:mcts": "node --import ./scripts/run-ts-node-esm.mjs src/training/evaluateMCTS.ts",
    "evaluate:mcts:playable": "node --import ./scripts/run-ts-node-esm.mjs src/training/evaluatePlayableMCTS.ts",
    "evaluate:mcts:adaptive-budget": "node --import ./scripts/run-ts-node-esm.mjs src/training/evaluateAdaptiveBudgetMCTS.ts",
    "evaluate:mcts:closure-threat-pilot": "node --import ./scripts/run-ts-node-esm.mjs src/training/evaluateImmediateTerritorialClosurePilot.ts",
    "evaluate:mcts:closure-verification": "node --import ./scripts/run-ts-node-esm.mjs src/training/evaluateClosureThreatVerification.ts",
    "confirm:mcts:closure-verification": "node --import ./scripts/run-ts-node-esm.mjs src/training/confirmClosureThreatVerification.ts",
    "replay:human-mcts": "node --import ./scripts/run-ts-node-esm.mjs src/training/replayHumanMCTSTrace.ts",
    "fixture:human-mcts": "node --import ./scripts/run-ts-node-esm.mjs src/training/extractHumanMCTSFixture.ts",
    "validate:human-mcts-trace": "node --import ./scripts/run-ts-node-esm.mjs src/training/validateHumanMCTSTrace.ts",
    "analyze:human-mcts": "node --import ./scripts/run-ts-node-esm.mjs src/training/analyzeHumanMCTSTrace.ts",
    "evaluate:human-mcts-counterfactual": "node --import ./scripts/run-ts-node-esm.mjs src/training/evaluateHumanMCTSCounterfactual.ts",
    "confirm:human-mcts-turn-10": "node --import ./scripts/run-ts-node-esm.mjs src/training/confirmHumanMCTSTurn10.ts",
    "evaluate:human-challenge-mcts": "node --import ./scripts/run-ts-node-esm.mjs src/training/evaluateHumanChallengeMCTSPilot.ts",
    "confirm:human-challenge-mcts": "node --import ./scripts/run-ts-node-esm.mjs src/training/confirmFinalHumanChallengeMCTS.ts",
    "human-experiment:register-participant": "node --import ./scripts/run-ts-node-esm.mjs src/training/registerHumanExperimentParticipant.ts",
    "human-experiment:register-game": "node --import ./scripts/run-ts-node-esm.mjs src/training/registerHumanExperimentGame.ts",
    "human-experiment:validate": "node --import ./scripts/run-ts-node-esm.mjs src/training/validateHumanExperiment.ts",
    "human-experiment:validate-v3": "node --import ./scripts/run-ts-node-esm.mjs src/training/validateHumanExperimentV3.ts",
    "human-experiment:validate-v3-archive": "node --import ./scripts/run-ts-node-esm.mjs src/training/validateHumanExperimentV3Archive.ts",
    "human-experiment:validate-v3-r1": "node --import ./scripts/run-ts-node-esm.mjs src/training/validateHumanExperimentV3R1.ts",
    "human-experiment:export": "node --import ./scripts/run-ts-node-esm.mjs src/training/exportHumanExperiment.ts",
    "human-experiment:start": "node scripts/start-human-experiment.mjs",
    "human-experiment:setup-participant": "node --import ./scripts/run-ts-node-esm.mjs src/training/setupHumanExperimentParticipant.ts",
    "human-experiment:ingest-latest": "node --import ./scripts/run-ts-node-esm.mjs src/training/ingestLatestHumanExperimentTrace.ts",
    "human-experiment:recover-transaction": "node --import ./scripts/run-ts-node-esm.mjs src/training/recoverHumanExperimentTransaction.ts",
    "evaluate:secured-territory-policy": "node --import ./scripts/run-ts-node-esm.mjs src/training/evaluateSecuredTerritoryPolicy.ts",
    "diagnostic:capture-secured-territory": "node --import ./scripts/run-ts-node-esm.mjs src/training/captureSecuredTerritoryDiagnostics.ts",
    "diagnostic:evaluate-secured-territory": "node --import ./scripts/run-ts-node-esm.mjs src/training/evaluateSecuredTerritoryDiagnostics.ts",
    "diagnostic:evaluate-inactive-scored-territory": "vite-node src/training/evaluateInactiveScoredTerritorySelection.ts",
    "training:analyze-q3-heuristic-traces": "node --import ./scripts/run-ts-node-esm.mjs src/training/analyzeHeuristicTracesForQ3.ts",
    "training:analyze-q3-representation": "node --import ./scripts/run-ts-node-esm.mjs src/training/analyzeQ3Representation.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/jsdom": "^21.1.7",
    "clsx": "^2.1.1",
    "i18next": "^25.2.1",
    "i18next-browser-languagedetector": "^8.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-helmet-async": "^2.0.5",
    "react-i18next": "^15.5.2",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.52.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "3.2.6",
    "eslint": "^9.25.0",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "playwright": "^1.52.0",
    "prettier": "3.5.3",
    "tailwindcss": "^4.1.7",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vitest": "3.2.6"
  }
}
